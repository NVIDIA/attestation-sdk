#define NVAT_VERSION_PATCH  @PROJECT_VERSION_PATCH@

// === Error Handling ===

/** @defgroup return_codes Return Codes
 *
 * The NVIDIA Attestation SDK uses return codes to communicate error
 * information.
 * All SDK functions that can fail return a value of type @ref nvat_rc_t,
 * with @ref NVAT_RC_OK (0) indicating successful operation.
 *
 * Error code ranges (inclusive):
 * - 0          : Success / OK
 * - 1 to 99    : General errors
 * - 100 to 199 : RIM service errors
 * - 200 to 299 : OCSP errors
 * - 300 to 399 : Relying party policy errors
 * - 400 to 499 : SPDM errors
 * - 500 to 599 : GPU errors
 * - 600 to 699 : NVSwitch errors
 * - 700 to 800 : NRAS errors
 * - 800 to 899 : Certificate errors
 * - 900 to 999 : Reserved for future use
 *
 * **Important**: Callers must assume that newer versions of the SDK will return codes not
 * yet defined below.
 * This ensures that adding additional error codes does not break ABI-compatibility.
 *
 * @{
 */

/**
 * @brief Return code type for NVIDIA Attestation SDK functions.
 */
typedef uint16_t nvat_rc_t;

/**
 * @brief Convert the given return code into a human-readable error message.
 */
const char* nvat_rc_to_string(nvat_rc_t rc);

/// @brief Indicates success (no error).
#define NVAT_RC_OK                             (0)
/// @brief Indicates an unknown error occurred.
#define NVAT_RC_UNKNOWN                        (1)
/// @brief Indicates a generic failure in the attestation SDK.
#define NVAT_RC_INTERNAL_ERROR                 (2)
/// @brief Indicates the SDK was used before nvat_sdk_init() was called.
#define NVAT_RC_NOT_INITIALIZED                (3)
/// @brief Indicates an invalid argument (usually a nullptr) was passed.
#define NVAT_RC_BAD_ARGUMENT                   (4)
/// @brief Indicates a memory allocation failed. Callers should consider this a fatal error and gracefully terminate if possible.
#define NVAT_RC_ALLOC_FAILED                   (5)
/// @brief Indicates that the caller attempted to use a feature that was not enabled when the SDK was compiled.
#define NVAT_RC_FEATURE_NOT_ENABLED            (6)
/// @brief Indicates a failure to initialize the required libXML or xmlsec libraries.
#define NVAT_RC_XML_INIT_FAILED                (7)
/// @brief Indicates a failure to initialize libcurl.
#define NVAT_RC_CURL_INIT_FAILED               (8)
/// @brief Indicates an error when parsing XML.
#define NVAT_RC_LIBXML2_ERROR                  (10)
/// @brief Indicates that a relying party policy rejected some or all of the supplied attestation results.
#define NVAT_RC_RP_POLICY_MISMATCH             (11)
/// @brief Indicates the overall attestation result was false.
#define NVAT_RC_OVERALL_RESULT_FALSE           (12)
/// @brief Indicates an error with JSON serialization/deserialization.
#define NVAT_RC_JSON_SERIALIZATION_ERROR       (13)
/// @brief Indicates an error occurred when fetching an object from the cache.
#define NVAT_RC_CACHE_OBJECT_NOT_FOUND         (14)
/// @brief Indicates a verifier or attestation service rate-limited the request.
#define NVAT_RC_RATE_LIMITED                   (15)
/// @brief Indicates that the evidence supplied to the verification function could not be parsed.
#define NVAT_RC_EVIDENCE_MALFORMED             (16)
/// @brief Indicates the evidence signature failed verification.
#define NVAT_RC_EVIDENCE_INVALID_SIGNATURE     (17)
/// @brief Indicates the nonce in the evidence did not match the expected nonce.
#define NVAT_RC_EVIDENCE_NONCE_MISMATCH        (18)
/// @brief Indicates the token's eat_nonce did not match the expected nonce supplied by the relying party.
#define NVAT_RC_NONCE_MISMATCH                 (19)
/// @brief Indicates the EAR JWT could not be signed (e.g. an invalid signing key).
#define NVAT_RC_EAR_SIGNING_FAILED             (20)
/// @brief Indicates the selected verifier JWKS was unavailable or unusable.
#define NVAT_RC_VERIFIER_JWKS_ERROR            (21)
/// @brief Indicates the client is not authorized to call the NVIDIA RIM service.
#define NVAT_RC_RIM_FORBIDDEN                  (101)
/// @brief Indicates an HTTP internal error occurred when calling the NVIDIA RIM service.
#define NVAT_RC_RIM_INTERNAL_ERROR             (102)
/// @brief Indicates a connection error occurred when calling the NVIDIA RIM service.
#define NVAT_RC_RIM_CONNECTION_ERROR           (103)
/// @brief Indicates no RIM was found with a given id.
#define NVAT_RC_RIM_NOT_FOUND                  (104)
/// @brief Indicates a signature verification error occurred when validating a RIM.
#define NVAT_RC_RIM_INVALID_SIGNATURE          (105)
/// @brief Indicates a schema validation error occurred when validating a RIM.
#define NVAT_RC_RIM_INVALID_SCHEMA             (106)
/// @brief Indicates a measurement was not found in a RIM.
#define NVAT_RC_RIM_MEASUREMENT_NOT_FOUND      (107)
/// @brief Indicates a measurement conflict occurred when validating a RIM.
#define NVAT_RC_RIM_MEASUREMENT_CONFLICT       (108)
/// @brief Indicates a non-recoverable error was encountered when calling the configured OCSP server.
#define NVAT_RC_OCSP_INVALID_RESPONSE          (201)
/// @brief Indicates the configured OCSP server responded with a code indicating an internal error.
#define NVAT_RC_OCSP_SERVER_ERROR              (202)
/// @brief Indicates the configured OCSP server rejected an OCSP request.
#define NVAT_RC_OCSP_INVALID_REQUEST           (203)
/// @brief Indicates an error occurred when the OCSP response status was not good.
#define NVAT_RC_OCSP_STATUS_NOT_GOOD           (204)
/// @brief Indicates client is not authorized to call the NVIDIA OCSP service.
#define NVAT_RC_OCSP_FORBIDDEN                 (205)
/// @brief Indicates an error occurred when attempting to apply a relying party policy to a set of claims.
#define NVAT_RC_POLICY_EVALUATION_ERROR        (301)
/// @brief Indicates a general error while parsing an SPDM transcript.
#define NVAT_RC_SPDM_PARSE_ERROR               (401)
/// @brief Indicates an error was encountered while parsing the opaque data section of an SPDM transcript.
#define NVAT_RC_SPDM_OPAQUE_DATA_PARSE_ERROR   (402)
/// @brief Indicates an error was encountered while parsing the measurements section of an SPDM transcript.
#define NVAT_RC_SPDM_MSR_PARSE_ERROR           (403)
/// @brief Indicates an error was encountered while parsing the SPDM request section of an SPDM transcript.
#define NVAT_RC_SPDM_REQUEST_PARSE_ERROR       (404)
/// @brief Indicates a required entry in the SPDM response opaque data was expected but not present.
#define NVAT_RC_SPDM_FIELD_NOT_FOUND           (405)
/// @brief Indicates a failure to initialize the NVIDIA Management Library (NVML).
#define NVAT_RC_NVML_INIT_FAILED               (500)
/// @brief Indicates a generic failure in the NVML library while performing a management operation.
#define NVAT_RC_NVML_ERROR                     (501)
/// @brief Indicates the system has at least one GPU connected that does not support attestation.
#define NVAT_RC_GPU_ARCHITECTURE_NOT_SUPPORTED (502)
/// @brief Indicates that the GPU evidence is invalid. Could be due to different reasons (for e.g evidence parsing failed, nonce mismatch, etc.)
#define NVAT_RC_GPU_EVIDENCE_INVALID            (503)
/// @brief Indicates the nonce in the gpu evidence does not match the nonce in the gpu attestation report.
#define NVAT_RC_GPU_EVIDENCE_NONCE_MISMATCH    (504)
/// @brief Indicates the driver RIM version from the RIM file does not match the driver RIM version in the GPU attestation report.
#define NVAT_RC_GPU_EVIDENCE_DRIVER_RIM_VERSION_MISMATCH (505)
/// @brief Indicates the VBios RIM version from the RIM file does not match the VBios RIM version in the GPU attestation report.
#define NVAT_RC_GPU_EVIDENCE_VBIOS_RIM_VERSION_MISMATCH (506)
/// @brief Indicates the FWID in the GPU evidence does not match the expected FWID.
#define NVAT_RC_GPU_EVIDENCE_FWID_MISMATCH (507)
/// @brief Indicates a signature verification error occurred when validating GPU evidence.
#define NVAT_RC_GPU_EVIDENCE_INVALID_SIGNATURE (508)
/// @brief Indicates the GPU is not running in a supported mode (CC or PPCIe).
#define NVAT_RC_GPU_MODE_NOT_SUPPORTED           (509)
/// @brief Indicates the GPU is running FW that is not supported by the attestation SDK.
#define NVAT_RC_GPU_FW_NOT_SUPPORTED             (510)
// TODO: Consider condensing GPU and switch error codes into fewer, more general error codes
/// @brief Indicates a failure to initialize NSCQ.
#define NVAT_RC_NSCQ_INIT_FAILED               (600)
/// @brief Indicates a generic error when invoking NSCQ.
#define NVAT_RC_NSCQ_ERROR                     (601)
/// @brief Indicates the system has at least one NVSwitch connected that does not support attestation.
#define NVAT_RC_SWITCH_ARCHITECTURE_NOT_SUPPORTED (602)
/// @brief Indicates the nonce in the switch evidence does not match the nonce in the switch attestation report.
#define NVAT_RC_SWITCH_EVIDENCE_NONCE_MISMATCH (603)
/// @brief Indicates the VBIOS RIM version from the RIM file does not match the VBIOS RIM version in the switch attestation report.
#define NVAT_RC_SWITCH_EVIDENCE_VBIOS_RIM_VERSION_MISMATCH (604)
/// @brief Indicates the FWID in the switch evidence does not match the expected FWID.
#define NVAT_RC_SWITCH_EVIDENCE_FWID_MISMATCH (605)
/// @brief Indicates a signature verification error occurred when validating switch evidence.
#define NVAT_RC_SWITCH_EVIDENCE_INVALID_SIGNATURE (606)
/// @brief Indicates a failure to initialize Corelib.
#define NVAT_RC_CORELIB_INIT_FAILED            (607)
/// @brief Indicates a generic error when invoking Corelib.
#define NVAT_RC_CORELIB_ERROR                  (608)
/// @brief Indicates an error occurred when calling the NVIDIA Remote Attestation Service.
#define NVAT_RC_NRAS_ATTESTATION_ERROR         (700)
/// @brief Indicates a token could not be authenticated.
#define NVAT_RC_NRAS_TOKEN_INVALID             (701)
/// @brief Indicates client is not authorized to call the NVIDIA NRAS service.
#define NVAT_RC_NRAS_FORBIDDEN                 (702)
/// @brief Indicates a given GPU device certificate did not contain a required firmware id.
#define NVAT_RC_CERT_FWID_NOT_FOUND            (800)
/// @brief Indicates an internal error occurred when traversing a certificate chain.
#define NVAT_RC_CERT_NOT_FOUND                 (801)
/// @brief Indicates a certificate chain verification failure.
#define NVAT_RC_CERT_CHAIN_VERIFICATION_FAILURE (802)
/// @brief Indicates an error parsing a COSE structure.
#define NVAT_RC_COSE_PARSE_ERROR                (901)
/// @brief Indicates a COSE signature verification failure.
#define NVAT_RC_COSE_INVALID_SIGNATURE          (902)
/// @brief Indicates a COSE x5t certificate thumbprint mismatch.
#define NVAT_RC_COSE_THUMBPRINT_MISMATCH        (903)

/** @} return_codes */

// === Core SDK ===

/**
 * @defgroup nvat_string NVAT String
 *
 * @brief Utilities for working with strings produced by the SDK.
 *
 * @{
 */

typedef struct nvat_str_st* nvat_str_t;

/**
 * @brief Get the length of the given string.
 */
nvat_rc_t nvat_str_length(const nvat_str_t str, size_t* out_length);

/**
 * @brief Get the data of the given string.
 *
 * The returned pointer refers to a buffer that may contain binary data and NUL (\0) bytes.
 * Do not assume it is a null-terminated C-string. Use @ref nvat_str_length for the size.
 *
 * **Ownership**: The ownership of the data is not transferred to the caller.
 * The caller should not free the data.
 */
nvat_rc_t nvat_str_get_data(const nvat_str_t str, char** out_data);

/**
 * @brief Free the given string.
 */
void nvat_str_free(nvat_str_t* str);

/** @} nvat_string */

/**
 * @defgroup options SDK Configuration
 *
 * @brief Common configuration for the attestation SDK.
 *
 * @{
 */

/**
 * @brief Options used to initialize the NVIDIA Attestation SDK.
 */
typedef struct nvat_sdk_opts_st* nvat_sdk_opts_t;

/**
 * @brief Pluggable logger for the attestation SDK.
 */
typedef struct nvat_logger_st* nvat_logger_t;

/**
 * @brief Common configuration for HTTP clients.
 */
typedef struct nvat_http_options_st* nvat_http_options_t;

/**
 * @brief JWT validation settings for signed attestation results.
 */
typedef struct nvat_jwt_validation_options_st* nvat_jwt_validation_options_t;

/**
 * @brief Enum indicating possible log levels.
 *
 * A log message is emitted if its log level is greater than or
 * equal to the logger's configured minimum level.
 */
typedef enum {
    NVAT_LOG_LEVEL_OFF   = 0,
    NVAT_LOG_LEVEL_TRACE = 1,
    NVAT_LOG_LEVEL_DEBUG = 2,
    NVAT_LOG_LEVEL_INFO  = 3,
    NVAT_LOG_LEVEL_WARN  = 4,
    NVAT_LOG_LEVEL_ERROR = 5
} nvat_log_level_t;

/**
 * @brief Allocate a new @ref nvat_sdk_opts_t on the heap.
 *
 */
nvat_rc_t nvat_sdk_opts_create(nvat_sdk_opts_t* out_opts);

void nvat_sdk_opts_free(nvat_sdk_opts_t* sdk_opts);

/**
 * @brief Sets the logger in the given options.
 *        Note that the logger is not installed until @ref nvat_sdk_init
 *        is called.
 */
void nvat_sdk_opts_set_logger(nvat_sdk_opts_t opts, nvat_logger_t logger);

/**
 * @brief Initialize the NVIDIA Attestation SDK with the given options.
 *
 * **Safety**: Callers should ensure the following:
 * - Initialization should only be attempted once, from the main application thread.
 * - Callers should not attempt to recover in case initialization fails.
 *   Behavior of the SDK and the state of the underlying dependencies after a failure
 *   is currently not defined.
 */
nvat_rc_t nvat_sdk_init(nvat_sdk_opts_t opts);

/**
 * @brief Shutdown the NVIDIA Attestation SDK.
 *
 * This operation will shutdown any dependencies initialized as part
 * of @ref nvat_sdk_init and free any resources owned by the active
 * @ref nvat_sdk_opts_t.
 */
void nvat_sdk_shutdown(void);

/**
 * @brief Create a new SPDLog Logger backend with the given name and
 *        log level.
 *        Logger will write to stdout.
 */
nvat_rc_t nvat_logger_spdlog_create(
    nvat_logger_t* out_logger,
    const char* name,
    nvat_log_level_t level
);

/**
 * @brief Logging callback to determine whether logging is enabled for the given level.
 * This called prior to each logging statement to avoid string formatting when it is
 * not necessary.
 * If the SDK is used across multiple threads, the implementation of this callback must be thread safe.
 * @param level The level of the pending log message
 * @param filename The name of the file in the source from which the log was emitted
 * @param function The name of the function in the source from which the log was emitted
 * @param line_number The line_number in the source from which the log was emitted
 * @param user_data Pointer to user-defined data
 */
typedef bool (*nvat_should_log_callback_t)(
    nvat_log_level_t level,
    const char* filename,
    const char* function,
    int line,
    void* user_data
);

/**
 * @brief Logging callback to write messages to a custom log system.
 * If the SDK is used across multiple threads, the implementation of this callback must be thread safe.
 * @param level The level of the incoming log message
 * @param message The formatted log message
 * @param filename The name of the file in the source from which the log was emitted
 * @param function The name of the function in the source from which the log was emitted
 * @param line_number The line_number in the source from which the log was emitted
 * @param user_data Pointer to user-defined data
 */
typedef void (*nvat_log_callback_t)(
    nvat_log_level_t level,
    const char* message,
    const char* filename,
    const char* function,
    int line,
    void* user_data
);

/**
 * @brief Flush callback to force immediate writing of any buffered log messages.
 * This is called by the SDK at critical points to ensure log persistence.
 * Implementations should handle errors internally and continue operating.
 * @param user_data Pointer to user-defined data
 */
 typedef void (*nvat_flush_callback_t)(void* user_data);

/**
 * @brief Create a custom logging implementation through callbacks.
 * See @ref nvat_should_log_callback_t and @ref nvat_log_callback_t for details on
 * the required callbacks.
 * `user_data` is a nullable pointer to user-defined data that should be passed to each
 * invocation of both the `should_log_callback` and `log_callback`.
 * `user_data` should be a pointer to any user defined data structures required to support
 * the custom logging implementation.
 * The caller is responsible for safe interaction with `user_data`, including thread safety
 * if the SDK is used from multiple threads.
 * @param log_callback Nullable callback to write log messages. If NULL, all messages are dropped.
 * @param should_log_callback Nullable callback to filter log messages. If NULL, no filtering is applied.
 * @param flush_callback Nullable callback to signal a request to flush buffered messages. If NULL, the callback is not invoked.
 * @param user_data Nullable pointer to user-defined data
 */
nvat_rc_t nvat_logger_callback_create(
    nvat_logger_t* out_logger,
    nvat_log_callback_t log_callback,
    nvat_should_log_callback_t should_log_callback,
    nvat_flush_callback_t flush_callback,
    void* user_data
);

void nvat_logger_free(nvat_logger_t* logger);

#define NVAT_HTTP_DEFAULT_RETRY_COUNT               (5)
#define NVAT_HTTP_DEFAULT_BASE_BACKOFF_MS         (100) // 100 ms
#define NVAT_HTTP_DEFAULT_MAX_BACKOFF_MS        (30000) // 30 seconds
#define NVAT_HTTP_DEFAULT_CONNECTION_TIMEOUT_MS  (5000) // 5 seconds
#define NVAT_HTTP_DEFAULT_REQUEST_TIMEOUT_MS    (30000) // 30 seconds

/** @brief Create a new set of HTTP options with default values. */
nvat_rc_t nvat_http_options_create_default(nvat_http_options_t* http_options);
/** @brief Sets the maximum number of retries on a failed HTTP request. At most `max(max_retries, 0) + 1` attempts will be made. */
void nvat_http_options_set_max_retry_count(nvat_http_options_t http_options, long max_retries);
/** @brief Sets the base backoff time, in milliseconds. A base backoff of 0 disables backoff between retries (not recommended). */
void nvat_http_options_set_base_backoff_ms(nvat_http_options_t http_options, long base_backoff_ms);
/** @brief Sets the maximum backoff time, in milliseconds. */
void nvat_http_options_set_max_backoff_ms(nvat_http_options_t http_options, long max_backoff_ms);
/** @brief Sets the connection timeout for each HTTP request. */
void nvat_http_options_set_connection_timeout_ms(nvat_http_options_t http_options, long connection_timeout_ms);
/** @brief Sets the overall request timeout of an HTTP request. */
void nvat_http_options_set_request_timeout_ms(nvat_http_options_t http_options, long request_timeout_ms);
/** @brief Sets the path to a TLS CA certificate bundle file (PEM). If not set, the system default is used. */
void nvat_http_options_set_tls_ca_cert(nvat_http_options_t http_options, const char* tls_ca_cert);
/** @brief Sets the path to a directory of TLS CA certificates. If not set, the system default is used. */
void nvat_http_options_set_tls_ca_path(nvat_http_options_t http_options, const char* tls_ca_path);
void nvat_http_options_free(nvat_http_options_t* http_options);

/**
 * @brief Create JWT validation settings with a 60-second clock-skew leeway.
 */
nvat_rc_t nvat_jwt_validation_options_create_default(
    nvat_jwt_validation_options_t* out_options);
/** @brief Set the clock-skew leeway used for JWT time claims. */
void nvat_jwt_validation_options_set_clock_skew_leeway_seconds(
    nvat_jwt_validation_options_t options, uint64_t seconds);
/** @brief Free JWT validation settings. */
void nvat_jwt_validation_options_free(
    nvat_jwt_validation_options_t* options);

/** @} options */


/**
 * @defgroup ocsp_client OCSP Client
 *
 * @brief OCSP client to check the revocation status of RIM and device identity
 *        certificate chains.
 * @{
 */
 // TODO(p2): auth
typedef struct nvat_ocsp_client_st* nvat_ocsp_client_t;

/** @brief Hash algorithm used to construct an OCSP CertID. */
typedef enum {
    NVAT_OCSP_CERT_ID_HASH_SHA256 = 0,
    NVAT_OCSP_CERT_ID_HASH_SHA1 = 1,
    NVAT_OCSP_CERT_ID_HASH_SHA384 = 2,
} nvat_ocsp_cert_id_hash_algorithm_t;

/**
 * @brief Parse a CertID hash algorithm name.
 *
 * Accepts SHA-1, SHA-256, and SHA-384, with or without a hyphen and
 * case-insensitively.
 *
 * @param name Algorithm name to parse. Must not be NULL.
 * @param out_algorithm Receives the parsed algorithm. Must not be NULL.
 */
nvat_rc_t nvat_ocsp_cert_id_hash_algorithm_from_name(
    const char* name,
    nvat_ocsp_cert_id_hash_algorithm_t* out_algorithm
);

/** @brief Construction options for an OCSP client. */
typedef struct nvat_ocsp_client_options_st* nvat_ocsp_client_options_t;

/**
 * @brief Allocate OCSP client construction options with SHA-256 defaults.
 *
 * @param out_options On success, receives an options handle. Free with
 *        @ref nvat_ocsp_client_options_free.
 */
nvat_rc_t nvat_ocsp_client_options_create_default(
    nvat_ocsp_client_options_t* out_options
);

/**
 * @brief Set the hash algorithm used to construct OCSP CertIDs.
 *
 * @param options Options handle to update.
 * @param algorithm CertID hash algorithm.
 */
nvat_rc_t nvat_ocsp_client_options_set_cert_id_hash_algorithm(
    nvat_ocsp_client_options_t options,
    nvat_ocsp_cert_id_hash_algorithm_t algorithm
);

void nvat_ocsp_client_options_free(nvat_ocsp_client_options_t* options);

/**
 * @brief Create an OCSP client with default settings.
 *
 * **Ownership**: On success, the caller assumes ownership of the allocated
 *                @ref nvat_ocsp_client_t handle.
 *                The client is refcounted and safe to share between multiple
 *                verifier components.
 * @param base_url If NULL, the default base URL of the NVIDIA OCSP Response is used.
 * @param http_options If NULL, default HTTP options will be used.
 *
 * URL can also be set using the NVAT_OCSP_BASE_URL environment variable.
 */
nvat_rc_t nvat_ocsp_client_create_default(
    nvat_ocsp_client_t* out_client,
    const char* base_url,
    const char* service_key,
    const nvat_http_options_t http_options
);

/**
 * @brief Create an OCSP client with explicit construction options.
 *
 * The options are copied during this call and remain owned by the caller.
 * Passing NULL uses fixed SHA-256 defaults and does not consult
 * NVAT_OCSP_CERT_ID_HASH_ALGORITHM. Other environment-backed settings, such as
 * the default base URL, retain their existing behavior.
 *
 * @param out_client On success, receives the client handle.
 * @param base_url If NULL, the default base URL is used.
 * @param service_key Service key for authenticated calls. NULL or "" for none.
 * @param http_options HTTP options. NULL uses defaults.
 * @param options Construction options to copy. NULL uses fixed SHA-256.
 */
nvat_rc_t nvat_ocsp_client_create_default_with_options(
    nvat_ocsp_client_t* out_client,
    const char* base_url,
    const char* service_key,
    const nvat_http_options_t http_options,
    const nvat_ocsp_client_options_t options
);

/**
 * @brief Create a cached OCSP client that wraps an existing OCSP client.
 *
 * **Ownership**: On success, the inner_client is safe to be free'd as it is
 *                refcounted
 * @param inner_client The inner OCSP client to wrap. Must not be NULL.
 * @param max_size_bytes The maximum size of the cache in bytes.
 * @param ttl_seconds The time-to-live for cached items in seconds. The ocsp
 * response will be cached for min(ttl_seconds, ocsp response next update time)
 */
nvat_rc_t nvat_ocsp_client_create_cached(
    nvat_ocsp_client_t* out_client,
    const nvat_ocsp_client_t inner_client,
    uint64_t max_size_bytes,
    time_t ttl_seconds
);

/**
 * @brief Create an OCSP client that derives each responder URL from the
 *        certificate's Authority Information Access extension — the client
 *        required by the V2 local CoRIM verifier.
 *
 * Unlike @ref nvat_ocsp_client_create_default, AIA responder lookup is on: the
 * responder URL is taken from each certificate's AIA extension. A certificate
 * that carries no AIA responder is skipped (its revocation status is not
 * checked) rather than falling back to @p base_url.
 * URL rewrites and the AIA behavior are fixed at construction, so the client
 * is safe to wrap with @ref nvat_ocsp_client_create_cached.
 * The options are copied during this call and remain owned by the caller.
 * Passing NULL uses fixed SHA-256 defaults and does not consult
 * NVAT_OCSP_CERT_ID_HASH_ALGORITHM.
 *
 * @param out_client On success, receives the client handle.
 * @param base_url Default responder URL used at construction. NULL uses the
 *        default. Not consulted per-certificate when AIA lookup is on.
 * @param service_key Service key for authenticated calls. NULL or "" for none.
 * @param http_options HTTP options. NULL uses defaults.
 * @param rewrite_patterns Prefix-substitution patterns applied to the responder
 *        URL before the request; first match wins. NULL when @p num_rewrites is 0.
 * @param rewrite_replacements Replacements paired with @p rewrite_patterns.
 * @param num_rewrites Number of entries in the rewrite arrays.
 * @param options Construction options to copy. NULL uses fixed SHA-256.
 */
nvat_rc_t nvat_ocsp_client_create_aia(
    nvat_ocsp_client_t* out_client,
    const char* base_url,
    const char* service_key,
    const nvat_http_options_t http_options,
    const char* const* rewrite_patterns,
    const char* const* rewrite_replacements,
    size_t num_rewrites,
    const nvat_ocsp_client_options_t options
);

void nvat_ocsp_client_free(nvat_ocsp_client_t* ocsp_client);

/** @} ocsp_client */

/**
 * @defgroup rim_store RIM Store
 *
 * @brief Utilities for fetching Remote Integrity Manifest (RIM) files
 *        from various sources.
 * @{
 */
typedef struct nvat_rim_store_st* nvat_rim_store_t;

/**
 * @brief Create a remote RIM store backed by the [NVIDIA RIM service](https://docs.nvidia.com/attestation/cloud-services/latest/rim/rim_api.html).
 *
 * If the `base_url` is empty,
 * the RIM store will use the default NVIDIA RIM service base URL to fetch RIMs.
 *
 * **Ownership**: On success, the caller assumes ownership of the allocated
 *                @ref nvat_rim_store_t.
 *                The client is refcounted and safe to share between multiple
 *                verifier components.
 *
 * @param base_url If NULL, the default base URL of the NVIDIA RIM Service is used.
 * @param http_options If NULL, default HTTP options will be used.
 *
 * URL can also be set using the NVAT_RIM_SERVICE_BASE_URL environment variable.
 *
 */
nvat_rc_t nvat_rim_store_create_remote(
    nvat_rim_store_t* out_store,
    const char* base_url,
    const char* service_key,
    const nvat_http_options_t http_options
);

/**
 * @brief Create a RIM store backed by the local filesystem.
 *
 * `base_path` must be a path to a directory containing RIM files.
 * The RIMs encoding is determined by the extension of the file (.xml, .corim).
 * When a RIM lookup by occurs, the store will check for the following files:
 * - `{rim_id}.xml`
 * - `{rim_id}.corim`
 *
 * If neither exists, the store will give up.
 *
 * **Ownership**: On success, the caller assumes ownership of the allocated
 *                @ref nvat_rim_store_t.
 *                The client is refcounted and safe to share between multiple
 *                verifier components.
 */
nvat_rc_t nvat_rim_store_create_filesystem(nvat_rim_store_t* out_store, const char* base_path);

/**
 * @brief Create a RIM store with in-memory caching that wraps an existing RIM store.
 *
 * The cached RIM store will cache RIM documents retrieved from the inner store
 * to reduce redundant fetches and improve performance.
 *
 * **Ownership**: On success, the caller assumes ownership of the allocated
 *                @ref nvat_rim_store_t.
 *                The client is refcounted and safe to share between multiple
 *                verifier components.
 *
 * @param out_store Output parameter for the cached RIM store handle.
 * @param inner_store The underlying RIM store to wrap with caching. Must not be NULL.
 * @param max_size_bytes Maximum total size of cached items in bytes.
 * @param ttl_seconds Time-to-live for cached items in seconds. Must be non-negative.
 * @return @ref NVAT_RC_OK on success, error code on failure.
 */

nvat_rc_t nvat_rim_store_create_cached(nvat_rim_store_t* out_store, const nvat_rim_store_t inner_store, uint64_t max_size_bytes, time_t ttl_seconds);

void nvat_rim_store_free(nvat_rim_store_t* rim_store);

/** @} rim_store */

// === Evidence Collection ===

/**
 * @brief A variable-length nonce.
 */
typedef struct nvat_nonce_st* nvat_nonce_t;

/**
 * @brief Generate a secure random nonce with the given length.
 *
 * Note that the required nonce length may vary by device.
 * The requested length must be at least 32 bytes.
 *
 * System must have access to a trusted entropy source.
 * @see <a href="https://docs.openssl.org/3.3/man3/RAND_bytes/">OpenSSL RAND_bytes</a>.
 */
nvat_rc_t nvat_nonce_create(nvat_nonce_t* out_nonce, size_t length);

/**
 * @brief Get the number of bytes in the given nonce.
 */
size_t nvat_nonce_get_length(const nvat_nonce_t nonce);

/**
 * @brief Encode the given nonce as a C-string.
 *
 * @param nonce The nonce to encode.
 * @param out_str *out_str will point to a heap allocated `nvat_str_t`. See @ref nvat_str_t.
 *
 */
nvat_rc_t nvat_nonce_to_hex_string(const nvat_nonce_t nonce, nvat_str_t* out_str);

/**
 * @brief Create a nonce from a hex-encoded string.
 *
 * Accepts optional "0x" or "0X" prefix. The hex string must contain an even
 * number of hex digits and decode to at least 32 bytes.
 *
 * @param out_nonce On success, set to a newly allocated nonce. Caller owns it; free with nvat_nonce_free().
 * @param hex_string The hex-encoded string representation of the nonce.
 */
nvat_rc_t nvat_nonce_from_hex(nvat_nonce_t* out_nonce, const char* hex_string);

/**
 * @brief Create a nonce from raw bytes.
 *
 * @param out_nonce On success, set to a newly allocated nonce. Caller owns it; free with nvat_nonce_free().
 * @param input_bytes The raw bytes to use as the nonce. This data is copied into the nonce.
 * @param length The number of bytes in input_bytes. Must be at least 32 bytes.
 * @return NVAT_RC_OK on success, NVAT_RC_BAD_ARGUMENT if parameters are invalid or length is too short.
 */
nvat_rc_t nvat_nonce_from_bytes(nvat_nonce_t* out_nonce, const char* input_bytes, size_t length);

/**
 * @brief Get a copy of the raw bytes from a nonce.
 *
 * This function copies the nonce's raw bytes into the provided buffer. The caller is responsible
 * for allocating a buffer of sufficient size. Use nvat_nonce_get_length() to determine the required
 * buffer size before calling this function.
 *
 * @param nonce The nonce to read from. Must not be null.
 * @param bytes Buffer to copy the nonce bytes into. Must not be null and must be at least bytes_len in size.
 *              The nonce data is COPIED into this buffer - the caller owns the buffer and the nonce remains unchanged.
 * @param bytes_len The size of the bytes buffer. Must match the nonce length exactly.
 * @return NVAT_RC_OK on success, NVAT_RC_BAD_ARGUMENT if parameters are invalid or bytes_len doesn't match nonce length.
 */
nvat_rc_t nvat_nonce_get_bytes(const nvat_nonce_t nonce, char* bytes, size_t bytes_len);

void nvat_nonce_free(nvat_nonce_t* nonce);

/**
 * @defgroup gpu_evidence GPU Evidence
 *
 * @brief Utilities to collect evidence from NVIDIA GPUs starting in the Hopper generation.
 *
 * @{
 */

/**
 * @brief A single piece of GPU evidence, generally an SPDM transcript.
 */
typedef struct nvat_gpu_evidence_st* nvat_gpu_evidence_t;
/**
 * @brief Interface for collecting or reading switch evidence.
 */
typedef struct nvat_gpu_evidence_source_st* nvat_gpu_evidence_source_t;

/**
 * @defgroup gpu_evidence_source GPU Evidence Source
 * @ingroup gpu_evidence
 *
 * Functions for creating GPU evidence sources.
 * @{
 */
/**
 * @brief Create a @ref nvat_gpu_evidence_source_t that will collect evidence from all GPUs accessible on
 *        the system via NVML.
 */
nvat_rc_t nvat_gpu_evidence_source_nvml_create(nvat_gpu_evidence_source_t* out_source);

/**
 * @brief Create a @ref nvat_gpu_evidence_source that will collect evidence from all GPUs
 *        accessible on the system via Corelib SPDM C API.
 *
 * @param out_source [out] Pointer to receive the evidence source handle
 * @param gpu_architecture GPU architecture string (currently only "blackwell" is supported)
 * @return NVAT_RC_OK on success, error code otherwise
 *
 */
nvat_rc_t nvat_gpu_evidence_source_corelib_create(nvat_gpu_evidence_source_t* out_source, const char* gpu_architecture);

/**
 * @brief Create a @ref nvat_gpu_evidence_source from a JSON string with the following schema:
 * ```json
 * {
 *   "$schema": "https://json-schema.org/draft/2020-12/schema",
 *   "type": "array",
 *   "items": {
 *     "type": "object",
 *     "properties": {
 *       "arch": {
 *         "type": "string",
 *         "description": "The GPU architecture of the evidence.",
 *         "enum": ["Hopper", "Blackwell"]
 *       },
 *       "nonce": {
 *         "type": "string",
 *         "description": "The nonce used to collect the evidence.",
 *         "format": "hex"
 *       },
 *       "evidence": {
 *         "type": "string",
 *         "description": "The base64-encoded evidence.",
 *         "format": "base64"
 *       },
 *       "certificate": {
 *         "type": "string",
 *         "description": "The base64-encoded certificate chain.",
 *         "format": "base64"
 *       }
 *     }
 *   }
 * }
 * ```
 * @param out_source A pointer to the evidence source that will return the evidence from the file.
 * @param json_string JSON formatted GPU evidence
 */
nvat_rc_t nvat_gpu_evidence_source_from_json_string(nvat_gpu_evidence_source_t* out_source, const char* json_string);

/**
 * @brief Create a @ref nvat_gpu_evidence_source_t that will read existing evidence from the given
 *        source file. The source file must be a JSON file with the above schema.
 *
 * @param out_source A pointer to the evidence source that will return the evidence from the file.
 * @param file_path The path to the file to deserialize the evidence from.
 */

nvat_rc_t nvat_gpu_evidence_source_from_json_file(nvat_gpu_evidence_source_t* out_source, const char* file_path);

void      nvat_gpu_evidence_source_free(nvat_gpu_evidence_source_t* gpu_evidence_source);

/** @} gpu_evidence_source */

/**
 * @defgroup gpu_evidence_collection GPU Evidence Collection
 * @ingroup gpu_evidence
 *
 * Functions for collecting GPU evidence.
 * @{
 */

/**
 * @brief Collect GPU evidence from the given source.
 *
 * The `nonce` must not be `NULL`. .
 */
nvat_rc_t nvat_gpu_evidence_collect(
    const nvat_gpu_evidence_source_t source,
    const nvat_nonce_t nonce,
    nvat_gpu_evidence_t** out_gpu_evidence_array,
    size_t* out_num_evidences
);

void nvat_gpu_evidence_array_free(nvat_gpu_evidence_t** gpu_evidence_array, size_t num_evidences);

/** @} gpu_evidence_collection */

/**
 * @defgroup gpu_evidence_serialize GPU Evidence Serialize
 * @ingroup gpu_evidence
 *
 * Functions for serializing GPU evidence.
 * @{
 */
/**
 * @brief Serialize the given GPU evidence to JSON.
 *
 * On success, `out_serialized_evidence` will point to a newly allocated
 * nvat_string_t that contains the serialized evidence in JSON format.
 *
 * The caller assumes ownership of the `out_serialized_evidence`
 * See @ref nvat_string
 */
nvat_rc_t nvat_gpu_evidence_serialize_json(
    const nvat_gpu_evidence_t* gpu_evidence_array,
    size_t num_evidences,
    nvat_str_t* out_serialized_evidence
);

/** @} gpu_evidence_serialize */

/** @} gpu_evidence */

/**
 * @defgroup switch_evidence NVSwitch Evidence
 *
 * @brief Utilities to collect evidence from the NVSwitch.
 *
 * @{
 */

/**
 * @brief A single piece of NVSwitch evidence, generally an SPDM transcript.
 */
typedef struct nvat_switch_evidence_st* nvat_switch_evidence_t;
/**
 * @brief Interface for collecting or reading NVSwitch evidence.
 */
typedef struct nvat_switch_evidence_source_st* nvat_switch_evidence_source_t;

/**
 * @defgroup switch_evidence_source NVSwitch Evidence Source
 * @ingroup switch_evidence
 *
 * Functions for creating NVSwitch evidence sources.
 * @{
 */
/**
 * @brief Create a @ref nvat_switch_evidence_source_t that will collect evidence from all NVSwitches
 * accessible from the system via NSCQ.
 */
nvat_rc_t nvat_switch_evidence_source_nscq_create(nvat_switch_evidence_source_t* out_source);

/**
 * @brief Create a @ref nvat_switch_evidence_source_t that will read existing evidence from the given
 *        source file. The source file must be a JSON file with the following schema:
 * ```json
 * {
 *   "$schema": "https://json-schema.org/draft/2020-12/schema",
 *   "type": "array",
 *   "items": {
 *     "type": "object",
 *     "properties": {
 *       "arch": {
 *         "type": "string",
 *         "description": "The switch architecture of the evidence.",
 *         "enum": ["LS10"]
 *       },
 *       "nonce": {
 *         "type": "string",
 *         "description": "The nonce used to collect the evidence.",
 *         "format": "hex"
 *       },
 *       "evidence": {
 *         "type": "string",
 *         "description": "The base64-encoded evidence.",
 *         "format": "base64"
 *       },
 *       "certificate": {
 *         "type": "string",
 *         "description": "The base64-encoded certificate chain.",
 *         "format": "base64"
 *       }
 *     }
 *   }
 * }
 * ```
 * @param out_source A pointer to the evidence source that will return the evidence from the JSON string.
 * @param json_string JSON formatted GPU evidence
 */
nvat_rc_t nvat_switch_evidence_source_from_json_string(nvat_switch_evidence_source_t* out_source, const char* json_string);

/**
 * @brief Create a @ref nvat_switch_evidence_source_t that will read existing evidence from the given
 *        source file. The source file must be a JSON file with the above schema.
 *
 * @param out_source A pointer to the evidence source that will return the evidence from the file.
 * @param file_path The path to the file to deserialize the evidence from.
 */

nvat_rc_t nvat_switch_evidence_source_from_json_file(nvat_switch_evidence_source_t* out_source, const char* file_path);

void      nvat_switch_evidence_source_free(nvat_switch_evidence_source_t* switch_evidence_source);

/** @} switch_evidence_source */

/**
 * @defgroup switch_evidence_collection NVSwitch Evidence Collection
 * @ingroup switch_evidence
 *
 * Functions for collecting NVSwitch evidence.
 * @{
 */

/**
 * @brief Collect NVSwitch evidence from the given source.
 *
 * The `nonce` must not be `NULL`.
 */
nvat_rc_t nvat_switch_evidence_collect(const nvat_switch_evidence_source_t source, const nvat_nonce_t nonce, nvat_switch_evidence_t** out_switch_evidence_array, size_t* out_num_evidences);

/** @} switch_evidence_collection */

/**
 * @defgroup switch_evidence_serialize NVSwitch Evidence Serialize
 * @ingroup switch_evidence
 *
 * Functions for serializing NVSwitch evidence.
 * @{
 */
/**
 * @brief Serialize the given NVSwitch evidence to JSON.
 *
 * On success, `buffer` will contain a null-terminated string.
 * On failure, caller must not make assumptions about the contents of
 * `buffer`.
 */
nvat_rc_t nvat_switch_evidence_serialize_json(
    const nvat_switch_evidence_t* switch_evidence_array,
    size_t num_evidences,
    nvat_str_t* out_serialized_evidence
);

void nvat_switch_evidence_array_free(nvat_switch_evidence_t** switch_evidence_array, size_t num_evidences);
/** @} switch_evidence_serialize */

/** @} switch_evidence */

// === Evidence Verification ===

/**
 * @brief Claims describing the properties of submitted evidence.
 */
 typedef struct nvat_claims_st* nvat_claims_t;

/**
 * @brief Options for generating a detached EAT.
 */
typedef struct nvat_detached_eat_options_st* nvat_detached_eat_options_t;

/**
 * @brief Alias for readability on the EAR-signing path — same underlying
 *        type as nvat_detached_eat_options_t (private_key_pem, issuer, kid).
 */
typedef nvat_detached_eat_options_t nvat_ear_signing_options_t;

/**
 * @brief Claims describing the properties of submitted evidence.
 *
 * \verbatim embed:rst:leading-asterisk
 * See for more info :ref:`Claims schema <claims-schema>` :ref:`Relying party policy <configuring-relying-part-policy>`.
 * \endverbatim
 */
typedef struct nvat_claims_collection_st* nvat_claims_collection_t;

nvat_rc_t nvat_claims_collection_extend(nvat_claims_collection_t nvat_claims_collection, const nvat_claims_collection_t other_claims_collection);
void nvat_claims_collection_free(nvat_claims_collection_t* claims_collection);

/**
 * @brief Serialize the given claims collection to JSON.
 */
nvat_rc_t nvat_claims_collection_serialize_json(const nvat_claims_collection_t claims, nvat_str_t* out_serialized_claims);


/**
 * @brief Create a detached EAT options object.
 *
 * @param private_key_pem - The private key to use to sign the detached EAT. If NULL, the EAT will not be signed.
 * Must be generated using ECDSA with the P-384 curve.
 * @param issuer - The issuer to use for the detached EAT. If NULL, will be set to "NVAT-LOCAL-VERIFIER".
 * @param kid - The kid to use for the detached EAT. If NULL, the kid header claim will not be set.
 * @param out_detached_eat - out parameter, will point to detached EAT, which is a NULL terminated JSON string
 */
nvat_rc_t nvat_detached_eat_options_create(nvat_detached_eat_options_t* out_options, const char* private_key_pem, const char* issuer, const char* kid);

void nvat_detached_eat_options_free(nvat_detached_eat_options_t* options);

/**
 * @param claims - The claims collection to get the detached EAT from.
 * @param options - The options to use for the detached EAT. If NULL, a default set of options will be used.
 * See @ref nvat_detached_eat_options_st for more information.
 * @param out_detached_eat - out parameter, will point to detached EAT, which is a NULL terminated JSON string
 */
nvat_rc_t nvat_get_detached_eat_es384(const nvat_claims_collection_t claims, const nvat_detached_eat_options_t options, nvat_str_t* out_detached_eat);

/**
 * @defgroup evidence_policy Evidence Policy
 *
 * @brief Settings to modify the behavior of a verifier.
 *
 * @{
 */

/**
 * @brief Settings to customize evidence verification.
 */
typedef struct nvat_evidence_policy_st* nvat_evidence_policy_t;

#define NVAT_GPU_CLAIMS_VERSION_V3 (3)
#define NVAT_GPU_CLAIMS_VERSION_V4 (4)
typedef uint8_t nvat_gpu_claims_version_t;

#define NVAT_SWITCH_CLAIMS_VERSION_V3 (3)
typedef uint8_t nvat_switch_claims_version_t;


/**
 * @brief Allocates a default evidence appraisal policy.
 *
 * The default evidence policy requires that:
 * - OCSP status must be "good"
 * - OCSP nonce must match between the OCSP request and response
 */
nvat_rc_t nvat_evidence_policy_create_default(nvat_evidence_policy_t* policy);

void nvat_evidence_policy_free(nvat_evidence_policy_t* evidence_policy);

/**
 * @brief Whether to verify the signatures on RIM files.
 *
 * Allows users to bypass RIM signature verification for testing.
 * Only supported for local verification.
 * If not set, defaults to `true`.
 * **Do not use in production deployments.**
 */
void nvat_evidence_policy_set_verify_rim_signature(nvat_evidence_policy_t policy, bool verify_rim_signature);

/**
 * @brief Whether to verify RIM file certificate chains.
 *
 * Allows users to bypass RIM certificate chian verification for testing.
 * Only supported for local verification.
 * If not set, defaults to `true`.
 * **Do not use in production deployments.**
 */
void nvat_evidence_policy_set_verify_rim_cert_chain(nvat_evidence_policy_t policy, bool verify_rim_cert_chain);

/**
 * @brief Set the expected claims version for GPU attestation results.
 */
nvat_rc_t nvat_evidence_policy_set_gpu_claims_version(nvat_evidence_policy_t policy, const nvat_gpu_claims_version_t version);

/**
 * @brief Set the expected claims version for switch attestation results.
 */
nvat_rc_t nvat_evidence_policy_set_switch_claims_version(nvat_evidence_policy_t policy, const nvat_switch_claims_version_t version);

/** @} evidence_policy */

/**
 * @defgroup gpu_verifier GPU Evidence Verification
 *
 * @brief Components used to perform GPU evidence verification and
 *        produce attestation results (claims) for a relying party.
 * @{
 */

/**
 * @brief Evaluates GPU evidence to produce attestation results (claims)
 *        indicating the validity of submitted evidence.
 */
typedef struct nvat_gpu_verifier_st* nvat_gpu_verifier_t;
typedef struct nvat_gpu_nras_verifier_st* nvat_gpu_nras_verifier_t;
typedef struct nvat_gpu_local_verifier_st* nvat_gpu_local_verifier_t;

/**
 * @brief Create a remote verifier that uses NVIDIA Remote Attestation Service
 *        to appraise evidence.
 *
 * @param base_url If `NULL`, will use the default NRAS production base URL
 * @param http_options If `NULL`, will use default HTTP options
 *
 * URL can also be set using the NVAT_NRAS_BASE_URL environment variable.
 */
nvat_rc_t nvat_gpu_nras_verifier_create(
    nvat_gpu_nras_verifier_t* out_verifier,
    const char* base_url,
    const char* service_key,
    const nvat_http_options_t http_options
);

/**
 * @brief Create a local verifier to appraise evidence in the current process.
 *
 * @param rim_store See @ref nvat_rim_store_st for more information.
 * @param ocsp_client See @ref nvat_ocsp_client_st for more information.
 * @param detached_eat_options If `NULL`, will use default detached EAT options.
 * See @ref nvat_detached_eat_options_st for more information.
 *
 * Verify evidence in the current process.
 * The local verifier should be used either in:
 * - a TEE connected to the attester
 * - a remote attestation service running in a secure cloud environment
 *
 * Local verification outside of these use cases is not recommended
 * as the verification process can be compromised by malicious actors
 * with elevated privileges on the host.
 */
nvat_rc_t nvat_gpu_local_verifier_create(
    nvat_gpu_local_verifier_t* out_verifier,
    nvat_rim_store_t rim_store,
    nvat_ocsp_client_t ocsp_client,
    nvat_detached_eat_options_t detached_eat_options
);

/**
 @brief Verify GPU evidence against a given evidence policy.
 *
 * @param verifier - The GPU verifier to use.
 * @param gpu_evidence_array The GPU evidences to verify.
 * @param num_evidences The number of evidences in the collection.
 * @param policy The evidence policy to apply.
 * @param out_detached_eat Pointer to store the detached EAT, which is a NULL terminated JSON string.
 * Pass NULL to not generate the detached EAT.
 * @param out_claims Pointer to store the resulting claims.
 *
 * @return
 *   - @ref NVAT_RC_OK if the evidence is verified successfully
 *   - @ref NVAT_RC_OVERALL_RESULT_FALSE if the `x-nvidia-overall-result` claim is false in the detached EAT
 *     This error can only be returned in out_detached_eat is not NULL (otherwise detached EAT is not generated)
 *   - Other error codes
 */
nvat_rc_t nvat_verify_gpu_evidence(
    const nvat_gpu_verifier_t verifier,
    const nvat_gpu_evidence_t* gpu_evidence_array,
    size_t num_evidences,
    const nvat_evidence_policy_t policy,
    nvat_str_t* out_detached_eat,
    nvat_claims_collection_t* out_claims
);

nvat_gpu_verifier_t nvat_gpu_local_verifier_upcast(nvat_gpu_local_verifier_t verifier);
nvat_gpu_verifier_t nvat_gpu_nras_verifier_upcast(nvat_gpu_nras_verifier_t verifier);
void nvat_gpu_verifier_free(nvat_gpu_verifier_t* gpu_verifier);

/** @} gpu_verifier */

/**
 * @defgroup switch_verifier NVSwitch Evidence Verification
 *
 * @brief Components used to perform NVSwitch evidence verification and
 *        produce attestation results (claims) for a relying party.
 * @{
 */

/**
 * @brief Evaluates NVSwitch evidence to produce attestation results (claims)
 *        indicating the validity of submitted evidence.
 */
typedef struct nvat_switch_verifier_st* nvat_switch_verifier_t;
typedef struct nvat_switch_nras_verifier_st* nvat_switch_nras_verifier_t;
typedef struct nvat_switch_local_verifier_st* nvat_switch_local_verifier_t;

/**
 * @brief Create a remote verifier that uses NVIDIA Remote Attestation Service
 *        to appraise evidence.
 *
 * @param base_url If `NULL`, will use the default NRAS production base URL
 * @param http_options If `NULL`, will use default HTTP options
 */
nvat_rc_t nvat_switch_nras_verifier_create(
    nvat_switch_nras_verifier_t* out_verifier,
    const char* base_url,
    const char* service_key,
    const nvat_http_options_t http_options
);

/**
 * @brief Create a local verifier to appraise evidence in the current process.
 *
 * @param rim_store See @ref nvat_rim_store_st for more information.
 * @param ocsp_client See @ref nvat_ocsp_client_st for more information.
 * @param detached_eat_options If `NULL`, will use default detached EAT options.
 * See @ref nvat_detached_eat_options_st for more information.
 * Verify evidence in the current process.
 * The local verifier should be used either in:
 * - a TEE connected to the attester
 * - a remote attestation service running in a secure cloud environment
 *
 * Local verification outside of these use cases is not recommended
 * as the verification process can be compromised by malicious actors
 * with elevated privileges on the host.
 */
nvat_rc_t nvat_switch_local_verifier_create(
    nvat_switch_local_verifier_t* out_verifier,
    nvat_rim_store_t rim_store,
    nvat_ocsp_client_t ocsp_client,
    nvat_detached_eat_options_t detached_eat_options
);

/**
 @brief Verify NVSwitch evidence against a given evidence policy.

 * @param verifier - The switch verifier to use.
 * @param switch_evidence_array The switch evidences to verify.
 * @param num_evidences The number of evidences in the collection.
 * @param policy The evidence policy to apply.
 * @param out_detached_eat Pointer to store the detached EAT, which is a NULL terminated JSON string.
 * Pass NULL to not generate the detached EAT.
 * @param out_claims Pointer to store the resulting claims.
 *
 * @return
 *   - @ref NVAT_RC_OK if the evidence is verified successfully
 *   - @ref NVAT_RC_OVERALL_RESULT_FALSE if the `x-nvidia-overall-result` claim is false in the detached EAT
 *     This error can only be returned in out_detached_eat is not NULL (otherwise detached EAT is not generated)
 *   - Other error codes
 */
nvat_rc_t nvat_verify_switch_evidence(
    const nvat_switch_verifier_t verifier,
    const nvat_switch_evidence_t* switch_evidence_array,
    size_t num_evidences,
    const nvat_evidence_policy_t policy,
    nvat_str_t* out_detached_eat,
    nvat_claims_collection_t* out_claims
);

nvat_switch_verifier_t nvat_switch_local_verifier_upcast(nvat_switch_local_verifier_t verifier);
nvat_switch_verifier_t nvat_switch_nras_verifier_upcast(nvat_switch_nras_verifier_t verifier);
void nvat_switch_verifier_free(nvat_switch_verifier_t* switch_verifier);

/** @} switch_verifier */

// === Attestation ===

/**
  * @defgroup rp_policy Relying Party Policy
  * @{
  */

/**
 * @brief Evaluates attestation results to determine whether the source attesters
 *        are trustworthy.
 *
 * The RP policy will be provided attestation results from every attested device type at the end of
 * an @ref nvat_attest_device call.
 */
typedef struct nvat_relying_party_policy_st* nvat_relying_party_policy_t;

/**
 * @brief Create a Rego relying party (RP) policy backed by [regorus](https://github.com/microsoft/regorus).
 * see @ref nvat_claims_collection_st for the format of the input to the policy
 */
nvat_rc_t nvat_relying_party_policy_create_rego_from_str(nvat_relying_party_policy_t* rp_policy, const char* rego_str);

/**
 * @brief Evaluate the given claims collection against a relying party policy.
 *
 * @param claims The claims collection to evaluate.
 * @param policy The relying party policy to evaluate the claims against.
 *
 * Returns NVAT_RC_OK if the claims match the policy, NVAT_RC_RELYING_PARTY_POLICY_MISMATCH if the claims do not match the policy.
 */
nvat_rc_t nvat_apply_relying_party_policy(nvat_relying_party_policy_t policy, const nvat_claims_collection_t claims);

/**
 * @brief Evaluate an Entity Attestation Result (EAR) JSON object against a
 *        relying party policy.
 *
 * This function validates only that @p ear_json contains a JSON object. It
 * does not authenticate the EAR or validate its schema. Callers must verify
 * remotely received EARs before using their policy decision.
 *
 * @param policy The relying party policy to evaluate.
 * @param ear_json A null-terminated JSON string containing the complete EAR
 *                 object supplied to Rego as `input`.
 *
 * @return
 *   - @ref NVAT_RC_OK if the EAR matches the policy
 *   - @ref NVAT_RC_RP_POLICY_MISMATCH if the EAR does not match the policy
 *   - @ref NVAT_RC_BAD_ARGUMENT if an argument is null, the JSON is malformed,
 *     or the JSON root is not an object
 *   - @ref NVAT_RC_POLICY_EVALUATION_ERROR if policy evaluation fails
 */
nvat_rc_t nvat_apply_relying_party_policy_to_ear(
    nvat_relying_party_policy_t policy,
    const char* ear_json
);

void nvat_relying_party_policy_free(nvat_relying_party_policy_t* relying_party_policy);

/** @} rp_policy */

/**
  * @defgroup attestation_result_verification Attestation Result Verification
  * @{
  */

/**
 * @brief Verify an NVIDIA attestation token (detached EAT) issued by NRAS.
 *
 * Intended for a relying party that receives an EAT out of band and wants to
 * verify it without re-running attestation. Fetches NRAS's published public
 * keys from `nras_base_url`/.well-known/jwks.json, verifies the ES384
 * signature of the overall and per-device submodule JWTs, validates the
 * submodule digests, and returns the verified claims.
 *
 * Apply a relying party policy to the result with
 * @ref nvat_apply_relying_party_policy. See @ref nvat_claims_collection_st for
 * the claims format.
 *
 * @note The token must always contain an `eat_nonce`. If @p expected_nonce is
 *       provided, the token's `eat_nonce` must equal it for freshness;
 *       otherwise the nonce value is not checked against any expected value.
 *
 * @param eat NULL-terminated detached-EAT JSON string to verify.
 * @param nras_base_url Base URL of the NRAS instance that issued the token
 *        (e.g. "https://nras.attestation.nvidia.com"). The JWKS path is
 *        appended internally. Must not be NULL.
 * @param service_key Optional service key sent with the JWKS fetch. The public
 *        NRAS JWKS endpoint does not require one; pass NULL to send no
 *        credential. Provided for consistency with the other remote calls and
 *        for deployments that authenticate the JWKS fetch.
 * @param expected_nonce Optional nonce the relying party expects the token to
 *        be bound to. When non-NULL, the token's overall `eat_nonce` must equal
 *        it or verification fails with NVAT_RC_NONCE_MISMATCH. Pass NULL to skip
 *        the nonce comparison. Not consumed; caller retains ownership.
 * @param http_options Optional HTTP/TLS options (CA roots, timeouts). Pass NULL
 *        for defaults.
 * @param jwt_validation_options Optional JWT time-claim validation settings.
 *        Pass NULL for the default 60-second clock-skew leeway.
 * @param out_claims Out parameter; on success points to a newly allocated
 *        claims collection. Caller owns it; free with
 *        nvat_claims_collection_free().
 * @return NVAT_RC_OK on success; NVAT_RC_OVERALL_RESULT_FALSE if the token's
 *         overall attestation result is false (with @p out_claims still set);
 *         NVAT_RC_NONCE_MISMATCH if @p expected_nonce was supplied and does not
 *         match the token's `eat_nonce`; NVAT_RC_NRAS_TOKEN_INVALID if the
 *         signature, issuer, or structure is invalid; NVAT_RC_BAD_ARGUMENT for
 *         NULL required arguments; other codes for HTTP/JWKS errors.
 */
nvat_rc_t nvat_verify_attestation_result(
    const char* eat,
    const char* nras_base_url,
    const char* service_key,
    nvat_nonce_t expected_nonce,
    nvat_http_options_t http_options,
    const nvat_jwt_validation_options_t jwt_validation_options,
    nvat_claims_collection_t* out_claims);

/**
 * @brief Authenticate a signed Entity Attestation Result (EAR).
 *
 * The SDK fetches the verifier's well-known JWKS, verifies the ES384
 * signature and issuer, and returns authenticated EAR JSON only on success.
 * It does not validate the EAR schema or appraisal semantics; callers can
 * apply those requirements through relying-party policy.
 *
 * @note The `iat`, `nbf`, and `exp` claims are validated when present but are
 *       not required. A token without `exp` has no token-defined expiration.
 *
 * @param ear_jwt Non-empty compact EAR JWT to verify.
 * @param verifier_base_url Non-empty HTTPS base URL for the verifier.
 * @param service_key Optional service key for the JWKS request. It is sent
 *        only to HTTPS nvidia.com hosts and subdomains; otherwise it is
 *        suppressed.
 * @param expected_nonce Optional expected nonce. When provided, the token must
 *        contain a matching canonical `eat_nonce`; otherwise the nonce claim is
 *        not inspected. The caller retains ownership.
 * @param http_options Optional HTTP/TLS settings. Pass NULL for defaults.
 * @param jwt_validation_options Optional JWT validation settings. Pass NULL
 *        for the default 60-second clock-skew leeway.
 * @param out_ear_json Required output parameter. It is set to NULL before
 *        validation and remains NULL on every failure. On success it receives
 *        a newly allocated authenticated EAR JSON string; free it with
 *        @ref nvat_str_free.
 */
nvat_rc_t nvat_verify_ear(
    const char* ear_jwt,
    const char* verifier_base_url,
    const char* service_key,
    nvat_nonce_t expected_nonce,
    nvat_http_options_t http_options,
    nvat_jwt_validation_options_t jwt_validation_options,
    nvat_str_t* out_ear_json
);

/** @} attestation_result_verification */

/**
 * @defgroup attest Attestation
 *
 * @brief Utilities to perform end-to-end attestation of a particular NVIDIA device
 * connected to a system. @ref nvat_attest_device() is the main function used
 * for this.
 *
 * See @ref nvat_attestation_ctx_st for available options.
 *
 * @{
 */

/**
 * @brief Context required to perform system attestation.
 * Settings included in the context:
 * - evidence source for each device type (Default: NVML for GPU, NSCQ for NVSwitch)
 * - verifiers for each device type (Default: Local)
 * - evidence policy
 * - relying party policy
 *
 *
 * functions beginning with nvat_attestation_ctx_* are used to set
 * these options
 */
typedef struct nvat_attestation_ctx_st* nvat_attestation_ctx_t;


/**
 * @brief Enum indicating the type of NVIDIA device to attest.
 * Valid bits include:
 * - @ref NVAT_DEVICE_GPU
 * - @ref NVAT_DEVICE_NVSWITCH
 */
 typedef uint32_t nvat_devices_t;

 /// @brief Device type for NVIDIA GPU
 #define NVAT_DEVICE_GPU      0
 /// @brief Device type for NVIDIA NVSwitch
 #define NVAT_DEVICE_NVSWITCH 1

/**
 * @brief Integer indicating a verifier backend to use.
 * Valid values include:
 * - @ref NVAT_VERIFY_LOCAL
 * - @ref NVAT_VERIFY_REMOTE
 */
typedef uint8_t nvat_verifier_type_t;

/// @brief Verify evidence locally in the current process
#define NVAT_VERIFY_LOCAL  0
/// @brief Verify evidence using a remote service
#define NVAT_VERIFY_REMOTE 1

/**
 * @brief Create a new attestation context with default settings for all
 *        enabled devices.
 *
 * Defaults to local evidence collection and verification.
 */
nvat_rc_t nvat_attestation_ctx_create(nvat_attestation_ctx_t* ctx);

/**
 * @brief Set the device type to attest on.
 * See @ref nvat_devices_t for valid values.
 */
nvat_rc_t nvat_attestation_ctx_set_device_type(nvat_attestation_ctx_t ctx, nvat_devices_t device_type);

/**
 * @brief Sets the verifier type for all enabled devices in this context.
 */
nvat_rc_t nvat_attestation_ctx_set_verifier_type(nvat_attestation_ctx_t ctx, nvat_verifier_type_t verifier_type);

/**
 * @brief Set the default NRAS url to use when using NVIDIA Remote Attestation Service as the remote verifier.
 * Note that this setting does **not** change the NRAS url of any verifiers
 * previously set in the context.
 */
nvat_rc_t nvat_attestation_ctx_set_default_nras_url(nvat_attestation_ctx_t ctx, const char * nras_url);

/**
 * @brief Set the effective evidence policy for this context.
 * @param evidence_policy if NULL, the existing policy is cleared and a default policy will be set.
 *
 * **Ownership**: On success, ownership of the evidence policy is transferred to the attestation context.
 */
nvat_rc_t nvat_attestation_ctx_set_evidence_policy(nvat_attestation_ctx_t ctx, nvat_evidence_policy_t* evidence_policy);

/**
 * @brief Set the effective relying party policy for this context.
 * @param rp_policy if NULL, the existing policy is cleared and a default policy will be set.
 */
nvat_rc_t nvat_attestation_ctx_set_relying_party_policy(nvat_attestation_ctx_t ctx, nvat_relying_party_policy_t rp_policy);

/**
 * @brief Change the default OCSP url to use when initializing local verifiers.
 * Note that this setting does **not** change the OCSP client of any verifiers
 * previously set in the context.
 */
nvat_rc_t nvat_attestation_ctx_set_default_ocsp_url(nvat_attestation_ctx_t ctx, const char * ocsp_url);

/**
 * @brief Change the default OCSP client to use when initializing local verifiers.
 * Note that this setting does **not** change the OCSP client of any verifiers
 * previously set in the context.
 */
nvat_rc_t nvat_attestation_ctx_set_default_ocsp_client(nvat_attestation_ctx_t ctx, nvat_ocsp_client_t ocsp_client);


/**
 * @brief Change the default RIM url to use when initializing local verifiers.
 * Note that this setting does **not** change the RIM store of any verifiers
 * previously set in the context.
 */
nvat_rc_t nvat_attestation_ctx_set_default_rim_store_url(nvat_attestation_ctx_t ctx, const char * rim_store_url);

/**
 * @brief Change the default RIM store to use when initializing local verifiers.
 *
 * Note that this setting does **not** change the RIM store of any verifiers
 * previously set in the context.
 */
nvat_rc_t nvat_attestation_ctx_set_default_rim_store(nvat_attestation_ctx_t ctx, nvat_rim_store_t rim_store);

/**
 * @brief Set the GPU evidence source to use a JSON file. See @ref nvat_gpu_evidence_source_from_json_file() for
 * the expected format of the JSON file.
 */
nvat_rc_t nvat_attestation_ctx_set_gpu_evidence_source_json_file(nvat_attestation_ctx_t ctx, const char* file_path);

/**
 * @brief Set the NVSwitch evidence source to use a JSON file. See @ref nvat_switch_evidence_source_from_json_file() for
 * the expected format of the JSON file.
 */
nvat_rc_t nvat_attestation_ctx_set_switch_evidence_source_json_file(nvat_attestation_ctx_t ctx, const char* file_path);

/**
 * @brief Set the service key to use when creating the remote verifiers, rim
 * store or the OCSP client.
 */
nvat_rc_t nvat_attestation_ctx_set_service_key(nvat_attestation_ctx_t ctx, const char* service_key);
/**
 * @brief Set the detached EAT options to use when generating the detached EAT.
 * If this function is not called, a default set of options will be used.
 * See @ref nvat_detached_eat_options_st for more information.
 */
nvat_rc_t nvat_attestation_ctx_set_detached_eat_options(nvat_attestation_ctx_t ctx, nvat_detached_eat_options_t detached_eat_options);

void nvat_attestation_ctx_free(nvat_attestation_ctx_t* attestation_ctx);

/**
 * @brief Run end-to-end attestation on the current system using settings
 *        in the @ref nvat_attestation_ctx_t.
 *
 * This operation will:
 * - collect evidence from each configured device type (GPU, switch, etc)
 *   using the configured evidence collectors
 * - evaluate every piece of evidence collected using the configured
 *   verifiers and produce attestation results in the form of claims
 * - evalute the final set of attestation results using the
 *   configured relying party policy
 *
 * On success, the pointer `out_claims` is updated to point
 * to a claims collection allocated on the heap.
 *
 * The attestation process can be configured by environment variables:
 *
 * If using a remote rim store, the URL can be set using `NVAT_RIM_STORE_BASE_URL`
 * If using remote OCSP, the URL can be set using `NVAT_OCSP_BASE_URL`
 * If using remote verifier, the URL can be set using `NVAT_NRAS_BASE_URL`
 *
 * @param ctx - The attestation context to use.
 * @param nonce - The nonce to use for the attestation. If NULL, a nonce will be generated.
 * @param out_claims - Pointer to store the claims collection, which is a
 * NULL terminated JSON string. If NULL, the claims collection will be discarded.
 * @param out_detached_eat - Pointer to store the detached EAT, which is a NULL terminated JSON string.
 * Pass NULL to not generate the detached EAT.
 *
 * @return
 *   - @ref NVAT_RC_OK if the system is trustworthy according to
 *          the RP policy (if RP policy is not set, this indicates that the `x-nvidia-overall-result` claim
 *          in the detached EAT is true)
 *   - @ref NVAT_RC_OVERALL_RESULT_FALSE if the `x-nvidia-overall-result` claim is false in the detached EAT
 *          (only if RP policy is not set)
 *   - @ref NVAT_RC_RP_POLICY_MISMATCH if the RP policy rejected the
 *          attestation results. (only if RP policy is set)
 *   - @ref NVAT_RC_INTERNAL_ERROR if an internal error occurs.
 *   - Other internal errors depending on the implementations supplied
 *     to the @ref nvat_attestation_ctx_t.
 *
 * \verbatim embed:rst:leading-asterisk
 * See for more info about configuring the attestation process: :ref:`Configuring attestation <configuring-attestation>`.
 * See here for claims schema: :ref:`Claims schema <claims-schema>`
 * \endverbatim
 */
nvat_rc_t nvat_attest_device(
    const nvat_attestation_ctx_t ctx,
    const nvat_nonce_t nonce,
    nvat_str_t* out_detached_eat,
    nvat_claims_collection_t* out_claims
);

/** @} attest */

/**
 * @defgroup cmw CMW Collection (V2 Input)
 *
 * @brief In-memory builder/serializer for the RATS Conceptual Message Wrapper
 *        input collection consumed by the V2 verifier.
 *
 * Profile URI: `tag:nvidia.com,2026:verifier-input/profiles/base/pre-1.0.0`.
 * @{
 */

/**
 * @brief Serialization format of a CMW collection.
 *
 * Use @ref NVAT_CMW_FORMAT_JSON. CBOR is reserved and currently returns
 * @ref NVAT_RC_FEATURE_NOT_ENABLED.
 */
typedef enum {
    NVAT_CMW_FORMAT_JSON = 0,
    NVAT_CMW_FORMAT_CBOR = 1,
} nvat_cmw_format_t;

/**
 * @brief Opaque handle to a CMW input collection.
 */
typedef struct nvat_cmw_collection_st* nvat_cmw_collection_t;

/**
 * @brief Build a CMW input collection from an array of GPU evidence.
 *
 * Each input evidence becomes one CMW evidence-item child labelled
 * `gpu_<i>` (zero-based). The outer collection carries the provided nonce
 * as `application/octet-stream`.
 *
 * @param out On success, set to the newly allocated collection. Free with
 *            @ref nvat_cmw_collection_free.
 * @param gpu_evidence_array Array of GPU evidence handles. Must not be NULL
 *                           and must contain at least one entry.
 * @param num_evidences Number of entries in @p gpu_evidence_array.
 * @param nonce Attestation nonce. Must not be NULL.
 *
 * TODO(v2): generalize for NVSwitch / EAT / non-GPU evidence.
 */
nvat_rc_t nvat_cmw_collection_create_from_gpu_evidence(
    nvat_cmw_collection_t* out,
    const nvat_gpu_evidence_t* gpu_evidence_array,
    size_t num_evidences,
    const nvat_nonce_t nonce
);

/**
 * @brief Build a CMW input collection from a raw SPDM transcript and PEM
 *        certificate chain.
 *
 * The evidence item is labelled @p label (e.g. `"device_0"`). When @p nonce
 * is non-NULL it is set as the per-evidence nonce; the verifier will check it
 * against the nonce signed into the SPDM transcript to confirm freshness. When
 * NULL, no per-evidence freshness check is performed.
 *
 * @param out On success, set to the newly allocated collection. Free with
 *            @ref nvat_cmw_collection_free.
 * @param label Label for the evidence item. Must not be NULL.
 * @param transcript Raw SPDM measurement transcript bytes. Must not be NULL.
 * @param transcript_len Length of @p transcript in bytes.
 * @param cert_pem PEM-encoded certificate chain bytes. Must not be NULL.
 * @param cert_pem_len Length of @p cert_pem in bytes.
 * @param nonce Expected per-evidence nonce (checked against the SPDM transcript),
 *              or NULL to skip the freshness check.
 */
nvat_rc_t nvat_cmw_collection_create_from_spdm_transcript(
    nvat_cmw_collection_t* out,
    const char* label,
    const uint8_t* transcript,
    size_t transcript_len,
    const uint8_t* cert_pem,
    size_t cert_pem_len,
    const nvat_nonce_t nonce
);

/**
 * @brief Build a CMW input collection from a signed EAT/CWT token.
 *
 * The token embeds its own device-identity chain, so no separate certificate
 * chain is needed. A non-NULL @p nonce is checked against the token's nonce
 * claim; NULL skips the freshness check.
 *
 * @param out On success, set to the newly allocated collection. Free with
 *            @ref nvat_cmw_collection_free.
 */
nvat_rc_t nvat_cmw_collection_create_from_eat(
    nvat_cmw_collection_t* out,
    const char* label,
    const uint8_t* signed_cwt,
    size_t signed_cwt_len,
    const nvat_nonce_t nonce
);

/**
 * @brief Serialize a CMW input collection.
 *
 * @param cmw Collection handle.
 * @param format Wire format. CBOR returns @ref NVAT_RC_FEATURE_NOT_ENABLED.
 * @param out_serialized On success, set to a newly allocated string. Free
 *                       with @ref nvat_str_free.
 */
nvat_rc_t nvat_cmw_collection_serialize(
    const nvat_cmw_collection_t cmw,
    nvat_cmw_format_t format,
    nvat_str_t* out_serialized
);

void nvat_cmw_collection_free(nvat_cmw_collection_t* cmw);

/** @} cmw */

/**
 * @defgroup corim_store CoRIM Store (V2)
 *
 * @brief Fetches CoRIM bodies from rim-locator URLs for the local verifier.
 *        Configure it, then inject it into @ref nvat_local_corim_verifier_create.
 *
 * @{
 */

/**
 * @brief Opaque handle to a CoRIM store.
 */
typedef struct nvat_corim_store_st* nvat_corim_store_t;

/**
 * @brief Create a CoRIM store seeded with the NVIDIA RIM allowlist prefix.
 *
 * @param out_store On success, receives the store handle. Free with
 *        @ref nvat_corim_store_free.
 * @param service_key Service key for https RIM fetches. Pass NULL or "" for none.
 * @param http_options HTTP options. NULL uses defaults.
 */
nvat_rc_t nvat_corim_store_create(
    nvat_corim_store_t* out_store,
    const char* service_key,
    const nvat_http_options_t http_options
);

/**
 * @brief Append a rim-locator URL rewrite rule (prefix substitution).
 *
 * When a rim-locator URL starts with @p pattern, the prefix is replaced with
 * @p replacement before fetching. Rules apply in insertion order; first match
 * wins. The pre-rewrite URL must still pass the allowlist, so rules redirect
 * the allowed endpoint to file:// mirrors or staging hosts without weakening
 * the input gate.
 */
nvat_rc_t nvat_corim_store_add_url_rewrite(
    nvat_corim_store_t store,
    const char* pattern,
    const char* replacement
);

/**
 * @brief Append an https:// prefix to the raw-URL allowlist checked before any
 *        rewrite.
 */
nvat_rc_t nvat_corim_store_add_allowed_url_prefix(
    nvat_corim_store_t store,
    const char* prefix
);

/**
 * @brief Enable in-memory LRU+TTL caching on a CoRIM store.
 *
 * Subsequent calls to the store's internal fetch path check the cache before
 * making any network or filesystem request. The cache key is the effective URL
 * after rewrites. Must be called before @ref nvat_local_corim_verifier_create
 * transfers ownership of the store.
 *
 * @param store           The store to configure. Must not be NULL.
 * @param max_size_bytes  Maximum total byte capacity of the cache. Must be > 0.
 * @param ttl_seconds     Time-to-live for each cached entry in seconds. Must be >= 0.
 * @return @ref NVAT_RC_OK on success, @ref NVAT_RC_BAD_ARGUMENT if store is
 *         NULL, max_size_bytes is 0, or ttl_seconds is negative.
 */
nvat_rc_t nvat_corim_store_enable_in_memory_cache(
    nvat_corim_store_t store,
    uint64_t           max_size_bytes,
    time_t             ttl_seconds
);

void nvat_corim_store_free(nvat_corim_store_t* store);

/** @} corim_store */

/**
 * @defgroup local_corim_verifier Local CoRIM Verifier (V2)
 *
 * @brief Verify a CMW input collection in-process. Replaces the legacy
 *        GPU/NVSwitch local verifiers for CoRIM-compliant devices.
 *
 * @{
 */

/**
 * @brief Opaque handle to a local CoRIM-based verifier.
 */
typedef struct nvat_local_corim_verifier_st* nvat_local_corim_verifier_t;

/**
 * @brief Create a local CoRIM verifier from injected collaborators.
 *
 * @param out_verifier On success, receives the verifier handle. Free with
 *        @ref nvat_local_corim_verifier_free.
 * @param corim_store Pointer to a RIM fetching collaborator handle (allowlist,
 *        rewrites, service key). Required. On success, ownership transfers to
 *        the verifier and @p *corim_store is set to NULL.
 * @param ocsp_client Revocation collaborator. NULL means no revocation
 *        checking.
 */
nvat_rc_t nvat_local_corim_verifier_create(
    nvat_local_corim_verifier_t* out_verifier,
    nvat_corim_store_t* corim_store,
    nvat_ocsp_client_t ocsp_client
);

/**
 * @brief Verify a CMW input collection and emit a signed EAR.
 *
 * Appraisal findings — cert chain status, OCSP, evidence signature, and the
 * measurement match — are collected per evidence item rather than enforced.
 * The return code reflects only whether the input could be processed; the
 * pass/fail verdict is derived from @p out_ear_jwt by the caller.
 *
 * @param verifier Handle from @ref nvat_local_corim_verifier_create.
 * @param cmw_data CMW collection bytes.
 * @param cmw_len Length of @p cmw_data in bytes.
 * @param format Wire format. CBOR returns @ref NVAT_RC_FEATURE_NOT_ENABLED.
 * @param ear_signing_options EAR-signing options (private_key_pem, issuer,
 *        kid), from @ref nvat_detached_eat_options_create.
 *        NULL, or an options handle with an empty private key, yields an
 *        unsigned EAR (alg=none) — for tests only; production callers must
 *        supply a key.
 * @param out_ear_jwt On success, set to a newly allocated string holding
 *        the EAR (Entity Attestation Result) JWT for this appraisal. Free
 *        with @ref nvat_str_free. May be NULL to discard the result.
 * @param out_ear_json On success, set to a newly allocated string holding
 *        the same EAR as unsigned JSON (no need to decode @p out_ear_jwt).
 *        Free with @ref nvat_str_free. May be NULL to discard the result.
 *
 * TODO: future signature also takes @ref nvat_evidence_policy_t. RP policy
 * is out of scope here.
 */
nvat_rc_t nvat_local_corim_verifier_verify_cmw(
    const nvat_local_corim_verifier_t verifier,
    const uint8_t* cmw_data,
    size_t cmw_len,
    nvat_cmw_format_t format,
    nvat_ear_signing_options_t ear_signing_options,
    nvat_str_t* out_ear_jwt,
    nvat_str_t* out_ear_json
);

/**
 * @brief Toggle CoRIM signature verification.
 *
 * When @p enabled is true (the default) the verifier requires every
 * fetched CoRIM to be a tagged signed-corim whose COSE_Sign1
 * signature checks out against the CoRIM trust store. When false,
 * the verifier additionally accepts unsigned CoRIMs (tagged
 * unsigned-corim-map) and skips signature validation on signed ones
 * — intended for development against unsigned fixtures, never for
 * production.
 */
nvat_rc_t nvat_local_corim_verifier_set_verify_rim_signature(
    nvat_local_corim_verifier_t verifier,
    bool enabled
);

/**
 * @brief Toggle signature verification on a CoEV fetched from the RIM service.
 *
 * Covers a concise-evidence blob fetched alongside a RIM, independent of the
 * RIM's own signature (@ref nvat_local_corim_verifier_set_verify_rim_signature)
 * since CoEV signing can lag CoRIM signing in a given deployment. Verification
 * is enabled by default; disabling it is never appropriate in production.
 */
nvat_rc_t nvat_local_corim_verifier_set_verify_coev_signature(
    nvat_local_corim_verifier_t verifier,
    bool enabled
);

/**
 * @brief Toggle evidence signature verification.
 *
 * Enabled by default. When false the verifier retains unsigned or badly-signed
 * evidence and all claims available from a parseable, untrusted chain,
 * including DTI ECTs and akpub. The result remains unverified and
 * contraindicated. Disable only for development fixtures.
 */
nvat_rc_t nvat_local_corim_verifier_set_verify_evidence_signature(
    nvat_local_corim_verifier_t verifier,
    bool enabled
);

/**
 * @brief Toggle certificate revocation checking via OCSP.
 *
 * When @p enabled is true (the default), the verifier checks revocation
 * of the device-identity chain and (when RIM signatures are verified)
 * the CoRIM signing chain. The default OCSP client derives each
 * responder URL from the certificate's Authority Information Access
 * extension. When disabled, chains are treated as not revoked.
 */
nvat_rc_t nvat_local_corim_verifier_set_verify_revocation(
    nvat_local_corim_verifier_t verifier,
    bool enabled
);

/**
 * @brief Set a fallback ConciseEvidence (#6.571 CBOR blob).
 *
 * When SPDM evidence yields no ECTs, the backup is parsed and its ECTs are
 * used instead. Bytes are stored as-is; parse errors surface during
 * @ref nvat_local_corim_verifier_verify_cmw.
 *
 * @param verifier Handle from @ref nvat_local_corim_verifier_create.
 * @param coev_data Raw bytes of a #6.571-tagged ConciseEvidence blob.
 * @param coev_len Length of @p coev_data in bytes.
 */
nvat_rc_t nvat_local_corim_verifier_set_backup_spdm_coev(
    nvat_local_corim_verifier_t verifier,
    const uint8_t* coev_data,
    size_t coev_len
);

/**
 * @brief Append a fallback RIM locator URI.
 *
 * When evidence contains no rim-locator URLs, the backup list is used
 * instead.
 *
 * @param verifier Handle from @ref nvat_local_corim_verifier_create.
 * @param uri Null-terminated RIM locator URI string.
 */
nvat_rc_t nvat_local_corim_verifier_add_backup_rim_locator(
    nvat_local_corim_verifier_t verifier,
    const char* uri
);

/**
 * @brief Hash algorithms for computing ear_nvidia_inputs.digests.
 *
 * Values are IANA Named Information registry hash algorithm IDs, the same
 * identifiers CoRIM and CoEV digest records use.
 */
typedef enum {
    NVAT_HASH_ALGORITHM_SHA256 = 1,
    NVAT_HASH_ALGORITHM_SHA384 = 7,
    NVAT_HASH_ALGORITHM_SHA512 = 8,
} nvat_hash_algorithm_t;

/**
 * @brief Set the default hash algorithms for ear_nvidia_inputs.digests.
 *
 * Used when the request does not ask for specific algorithms; an input
 * carrying ars.digest-algos overrides this. Defaults to
 * {NVAT_HASH_ALGORITHM_SHA256}. Pass num_algs=0 to disable digest output.
 *
 * @param verifier Handle from @ref nvat_local_corim_verifier_create.
 * @param algs     Array of hash algorithm identifiers.
 * @param num_algs Number of elements in @p algs.
 */
nvat_rc_t nvat_local_corim_verifier_set_default_hash_algorithms(
    nvat_local_corim_verifier_t verifier,
    const nvat_hash_algorithm_t* algs,
    size_t num_algs
);

void nvat_local_corim_verifier_free(nvat_local_corim_verifier_t* verifier);

/** @} local_corim_verifier */

#ifdef __cplusplus
}
#endif

#endif // _NVAT_H_
