extern "C" {
#endif

#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <time.h>

// === Package Version ===

#define NVAT_VERSION_STRING "@PROJECT_VERSION@"
#define NVAT_VERSION_MAJOR  @PROJECT_VERSION_MAJOR@
